{
  "manifest_version": 3,

  "name": "SanitizerPro",
  "short_name": "SanitizerPro",
  "version": "1.0.0",

  "description": "Local-first AI data protection for your browser. Detect, warn, mask, or block sensitive data before it reaches AI platforms, AI search, coding assistants, and search engines.",

  "homepage_url": "https://github.com/SanitizerPro/sanitizer",

  "action": {
    "default_title": "SanitizerPro",
    "default_popup": "public/popup.html"
  },

  "options_ui": {
    "page": "public/options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",

    "https://claude.ai/*",

    "https://gemini.google.com/*",

    "https://copilot.microsoft.com/*",

    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",

    "https://grok.com/*",
